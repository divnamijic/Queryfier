<?xml version="1.0" encoding="UTF-8"?>

<project name="EdgeConverter800G6" default="compile" basedir="."
    xmlns:sonar="antlib:org.sonar.ant">
    <description>Builds, tests, and runs the project EdgeConverter800G6.</description>
    <import file="nbproject/build-impl.xml"/>

    <!-- Define properties -->
    <property name="src.dir" value="src" />
    <property name="classes.dir" value="classes" />
    <property name="lib.dir" value="lib" />
    <property name="dist.dir" value="dist" />

    <!-- Define the SonarQube properties -->
    <property name="sonar.host.url" value="https://08da-193-198-65-196.ngrok-free.app" />
    <property name="sonar.projectKey" value="Queryfier-SonarQube" />
    <property name="sonar.projectName" value="Queryfier SonarQube" />
    <property name="sonar.token" value="sqp_ac450cb6efc993863e45b31c2f400f4df417b57d" /> <!-- token -->
    <property name="sonar.projectVersion" value="1.0" />
    <property name="sonar.sources" value="src" />
    <property name="sonar.java.binaries" value="classes" />
    <property name="sonar.java.libraries" value="lib/*.jar" />
    <property name="sonar.scm.disabled" value="true" /> <!-- In case the project is not versioned, do not make sonar detect the scm -->

    <!-- Define the SonarScanner target -->
    <target name="sonar">
        <taskdef uri="antlib:org.sonar.ant" resource="org/sonar/ant/antlib.xml">
            <classpath path="lib/sonarqube-ant-task-2.7.1.1951.jar" />
        </taskdef>
        <!-- Execute SonarScanner for Ant Analysis -->
        <sonar:sonar />
    </target>

    <target name="clean">
        <delete dir="${dist.dir}" />
        <delete dir="${classes.dir}" />
    </target>

    <target name="init">
        <mkdir dir="${dist.dir}" />
        <mkdir dir="${classes.dir}" />
    </target>

    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false">
            <compilerarg line="--module-path ${lib.dir}" />
            <compilerarg line="--add-modules javafx.controls,javafx.fxml" />
            <classpath>
                <fileset dir="${lib.dir}" includes="*.jar" />
            </classpath>
        </javac>
    </target>

    <target name="archive" depends="compile" description="Creates the JAR file">
        <jar destfile="dist/queryfier.jar" basedir="classes">
            <zipgroupfileset dir="lib" includes="*.jar" />
            <fileset dir="src" includes="assets/**"/>
            <fileset dir="src" includes="screens/**"/>
            <manifest>
                <attribute name="Main-Class" value="edu.rit.croatia.iste422.g6.qf.QueryfierRunner" />
                <attribute name="Multi-Release" value="true" />
            </manifest>
        </jar>
    </target>

    <target name="run" depends="archive">
        <java jar="${dist.dir}/queryfier.jar" fork="true"/>
    </target>

</project>
